# Copy this file to ".env" (same folder as app.py) and fill in real values.

# Get a FREE key at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=gsk_your-real-key-here

# Your MySQL root password.
MYSQL_PASSWORD=your_mysql_password_here

# Never commit the real .env file to Git - add ".env" to your .gitignore.
